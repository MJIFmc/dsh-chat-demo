diff --git a/src/services/dshConfig.ts b/src/services/dshConfig.ts
new file mode 100644
index 0000000..a41c9d0
--- /dev/null
+++ b/src/services/dshConfig.ts
@@ -0,0 +1,129 @@
+import { create } from 'zustand'
+
+/** DeepSeek Harness（DSH）宿主注入的模型条目 */
+export type DshModelFeatures = {
+  /** 是否支持 deepseek_read_url / deepseek_web_search 服务端工具 */
+  serverTools?: boolean
+  /** 是否支持服务端自动生成标题 */
+  title?: boolean
+  /** 是否支持 latest_reminder 消息扩展 */
+  reminders?: boolean
+  /** 是否接受图片/附件输入 */
+  image?: boolean
+}
+
+export type DshModel = {
+  id: string
+  name?: string
+  description?: string
+  thinking?: boolean
+  image?: boolean
+  features?: DshModelFeatures
+}
+
+/** 宿主的凭据模式：账号登录 / API Key / 未配置 */
+export type DshAuthMode = 'account' | 'apiKey' | 'none' | null
+
+type DshConfigState = {
+  /** 配置请求是否已经结束（成功或失败） */
+  loaded: boolean
+  /** 是否由本机 DSH 代管 API 配置；为 true 时不需要用户填写 API Key */
+  managed: boolean
+  authMode: DshAuthMode
+  models: DshModel[]
+  defaultModel: string | null
+  load: () => Promise<void>
+}
+
+/** 未连接 DSH 宿主时（例如直接用静态服务器打开 dist）可选的模型 */
+export const FALLBACK_MODELS: DshModel[] = [
+  {
+    id: 'deepseek-flash',
+    name: 'DeepSeek V4.1 Flash',
+    thinking: true,
+    image: true,
+    features: { serverTools: true, title: true, reminders: true, image: true },
+  },
+  {
+    id: 'deepseek-v4-pro',
+    name: 'DeepSeek V4 Pro',
+    thinking: true,
+    image: false,
+    features: { serverTools: false, title: false, reminders: false, image: false },
+  },
+]
+
+/**
+ * 某个模型在本 demo 协议下可用的附加能力。宿主配置优先；
+ * 没有配置时按 deepseek-flash 系列支持服务端工具与标题来保守回退。
+ */
+export const modelFeatures = (modelId: string) => {
+  const model = useDshConfig.getState().models.find((item) => item.id === modelId)
+  const flashLike = /^deepseek-flash/i.test(modelId)
+  return {
+    serverTools: model?.features?.serverTools ?? flashLike,
+    title: model?.features?.title ?? flashLike,
+    reminders: model?.features?.reminders ?? flashLike,
+    image: model?.features?.image ?? model?.image ?? flashLike,
+  }
+}
+
+/**
+ * 读取宿主配置（服务地址固定为同源的 `/chat-demo/config`，由 DSH 插件提供）。
+ * 纯静态部署或请求失败时回退到内置模型列表，并保留手动填写 API Key 的路径。
+ */
+export const useDshConfig = create<DshConfigState>((set, get) => ({
+  loaded: false,
+  managed: false,
+  authMode: null,
+  models: FALLBACK_MODELS,
+  defaultModel: null,
+  async load() {
+    if (get().loaded) {
+      return
+    }
+    const controller = new AbortController()
+    const timer = setTimeout(() => controller.abort(), 5000)
+    try {
+      const response = await fetch('/chat-demo/config', {
+        headers: { Accept: 'application/json' },
+        signal: controller.signal,
+      })
+      if (!response.ok) {
+        throw new Error(`HTTP ${response.status}`)
+      }
+      const config = (await response.json()) as {
+        managed?: boolean
+        models?: DshModel[]
+        defaultModel?: string
+        auth?: { mode?: DshAuthMode }
+      }
+      const models = Array.isArray(config.models)
+        ? config.models.filter(
+            (model): model is DshModel =>
+              typeof model?.id === 'string' && model.id.length > 0
+          )
+        : []
+      set({
+        loaded: true,
+        managed: config.managed === true,
+        authMode: config.auth?.mode ?? null,
+        models: models.length > 0 ? models : FALLBACK_MODELS,
+        defaultModel:
+          typeof config.defaultModel === 'string' && config.defaultModel.length > 0
+            ? config.defaultModel
+            : null,
+      })
+    } catch {
+      set({
+        loaded: true,
+        managed: false,
+        authMode: null,
+        models: FALLBACK_MODELS,
+        defaultModel: null,
+      })
+    } finally {
+      clearTimeout(timer)
+    }
+  },
+}))
